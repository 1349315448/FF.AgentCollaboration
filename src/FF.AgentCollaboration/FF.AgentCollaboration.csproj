<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FF.AgentCollaboration</AssemblyName>
    <RootNamespace>FF.AgentCollaboration</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Tomlyn" Version="2.11.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.261109001" GeneratePathProperty="true" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../docs/licenses/YamlDotNet.txt" Link="licenses/YamlDotNet.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="启动工作台.bat" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="$(WebRtcBridgeFile)" Condition="'$(WebRtcBridgeFile)' != ''"
          Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Skills/ff-agent-collab/SKILL.md" TargetPath="ff-agent-collab/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Skills/ff-acp-knowledge/SKILL.md" TargetPath="ff-acp-knowledge/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Skills/ff-team-leader/SKILL.md" TargetPath="ff-team-leader/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Skills/ff-team-member/SKILL.md" TargetPath="ff-team-member/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PkgMicrosoft_Windows_Console_ConPTY)' != ''">
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe"
          Link="runtimes\win-x64\native\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\arm64\OpenConsole.exe"
          Link="runtimes\win-arm64\native\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x86\OpenConsole.exe"
          Link="runtimes\win-x86\native\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishWindowsWebRtcBridge" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(WebRtcBridgeFile)' == ''">
    <PropertyGroup>
      <_WebRtcRuntime>$(RuntimeIdentifier)</_WebRtcRuntime>
      <_WebRtcRuntime Condition="'$(_WebRtcRuntime)' == ''">$(DefaultAppHostRuntimeIdentifier)</_WebRtcRuntime>
      <_WebRtcRuntime Condition="'$(_WebRtcRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</_WebRtcRuntime>
    </PropertyGroup>
    <PropertyGroup Condition="$(_WebRtcRuntime.StartsWith('win'))">
      <_WebRtcArch Condition="$(_WebRtcRuntime.EndsWith('-x64'))">amd64</_WebRtcArch>
      <_WebRtcArch Condition="$(_WebRtcRuntime.EndsWith('-arm64'))">arm64</_WebRtcArch>
      <_WebRtcArch Condition="$(_WebRtcRuntime.EndsWith('-x86'))">386</_WebRtcArch>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_WebRtcArch)' != ''">
      <_WebRtcSource>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../FF.AgentCollaboration.WebRtc'))</_WebRtcSource>
      <_WebRtcOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'webrtc', '$(_WebRtcArch)'))</_WebRtcOutputDirectory>
      <_WebRtcOutput>$(_WebRtcOutputDirectory)FF.AgentCollaboration.WebRtc.exe</_WebRtcOutput>
    </PropertyGroup>
    <MakeDir Condition="'$(_WebRtcArch)' != ''" Directories="$(_WebRtcOutputDirectory)" />
    <Exec Condition="'$(_WebRtcArch)' != ''" WorkingDirectory="$(_WebRtcSource)"
          EnvironmentVariables="GOOS=windows;GOARCH=$(_WebRtcArch);CGO_ENABLED=0"
          Command="go build -mod=readonly -buildvcs=false -trimpath -o &quot;$(_WebRtcOutput)&quot; ." IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_WebRtcBuildExitCode" />
    </Exec>
    <Error Condition="'$(_WebRtcArch)' != '' and '$(_WebRtcBuildExitCode)' != '0'"
           Text="无法构建 WebRTC 后台组件。请确认发布环境已安装 Go 1.24 或更高版本，且 go 在 PATH 中，或通过 WebRtcBridgeFile 指定已构建的组件。" />
    <ItemGroup Condition="'$(_WebRtcArch)' != ''">
      <ResolvedFileToPublish Include="$(_WebRtcOutput)" RelativePath="FF.AgentCollaboration.WebRtc.exe"
                             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
