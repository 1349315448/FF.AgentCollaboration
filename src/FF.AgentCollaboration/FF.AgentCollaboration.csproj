<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FF.AgentCollaboration</AssemblyName>
    <RootNamespace>FF.AgentCollaboration</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.261109001" GeneratePathProperty="true" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Update="Skills/ff-agent-collab/SKILL.md" TargetPath="ff-agent-collab/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PkgMicrosoft_Windows_Console_ConPTY)' != ''">
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe"
          Link="runtimes\win-x64\native\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\arm64\OpenConsole.exe"
          Link="runtimes\win-arm64\native\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x86\OpenConsole.exe"
          Link="runtimes\win-x86\native\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="LegacyReleaseEntryPoints" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <CompatFile Include="exe;dll;deps.json;runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(CompatFile->'$(TargetDir)$(AssemblyName).%(Identity)')"
          DestinationFiles="@(CompatFile->'$(TargetDir)LX.AgentCollaboration.%(Identity)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
