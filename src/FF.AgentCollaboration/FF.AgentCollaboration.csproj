<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FF.AgentCollaboration</AssemblyName>
    <Version>1.0.7</Version>
    <RootNamespace>FF.AgentCollaboration</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ConPtyRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ConPtyRuntimeIdentifier>
    <ConPtyRuntimeIdentifier Condition="'$(ConPtyRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ConPtyRuntimeIdentifier>
    <ConPtyWindowsRuntime Condition="$(ConPtyRuntimeIdentifier.StartsWith('win'))">true</ConPtyWindowsRuntime>
    <ConPtyArchitecture Condition="$(ConPtyRuntimeIdentifier.EndsWith('-x64'))">x64</ConPtyArchitecture>
    <ConPtyArchitecture Condition="$(ConPtyRuntimeIdentifier.EndsWith('-arm64'))">arm64</ConPtyArchitecture>
    <ConPtyArchitecture Condition="$(ConPtyRuntimeIdentifier.EndsWith('-x86'))">x86</ConPtyArchitecture>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Tomlyn" Version="2.11.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.261109001" GeneratePathProperty="true" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../docs/licenses/YamlDotNet.txt" Link="licenses/YamlDotNet.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="启动工作台.bat" Condition="'$(ConPtyWindowsRuntime)' == 'true'" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Skills/ff-agent-collab/SKILL.md" TargetPath="ff-agent-collab/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Skills/ff-acp-knowledge/SKILL.md" TargetPath="ff-acp-knowledge/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Skills/ff-team-leader/SKILL.md" TargetPath="ff-team-leader/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Skills/ff-team-member/SKILL.md" TargetPath="ff-team-member/SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PkgMicrosoft_Windows_Console_ConPTY)' != '' and '$(ConPtyWindowsRuntime)' == 'true' and '$(ConPtyArchitecture)' != ''">
    <!-- conpty.dll is a native runtime asset and .NET places it in the application root.
         The library only discovers its matching OpenConsole.exe beside itself (or in an
         architecture-named child directory), so keep the two package binaries together. -->
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\$(ConPtyArchitecture)\OpenConsole.exe"
          Link="OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../Shared/WebRtcPublish.targets" />
  <ItemGroup>
    <Compile Include="../Shared/ManagedUpdates.cs" Link="Infrastructure/Updates/ManagedUpdates.cs" />
    <Compile Include="../Shared/UpdateSupervisor.cs" Link="Infrastructure/Updates/UpdateSupervisor.cs" />
  </ItemGroup>
  <Import Project="../Shared/UnixPty.targets" />
</Project>
